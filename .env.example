# Supabase Backend Configuration (Required for Production Authentication & Database)
# In Supabase Project Settings -> API, find your Project URL and Anon Key.
# Set these in your Netlify or deployment environment variables:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GEMINI_API_KEY: Required for Gemini AI educational story & music creation.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=
